# =========================
# OS
# =========================
.DS_Store
Thumbs.db

# =========================
# Python
# =========================
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so

# 虛擬環境
.venv/
venv/
env/
ENV/

# =========================
# FastAPI / Backend
# =========================
*.log
*.sqlite3
*.db

# metadata runtime files（分析結果不要上傳）
apk-platform/metadata/

# storage（上傳 APK 不要進 git）
apk-platform/storage/

# =========================
# AI model artifacts
# =========================
AI-model/__pycache__/
AI-model/*.pt
AI-model/*.pth
AI-model/data/
AI-model/output/

# 模型產生的 features / json
*.features.json
*.report.json

# =========================
# APK
# =========================
# 一般情況下不追蹤 .apk（platform storage、build 產物等）
*.apk
# 例外：dataset/ 下的 toy/opensource/public APK 需要進 git
!AI-model/dataset/toy_apks/**/*.apk
!AI-model/dataset/opensource_apks/**/*.apk
!AI-model/dataset/public_apks/**/*.apk

# =========================
# Toy APK Android Studio 原始碼（不進 git，只 commit build 出來的 .apk）
# =========================
AI-model/toy_apk_sources/

# =========================
# Node / Frontend
# =========================
node_modules/
dist/
build/
.cache/
.vite/

# =========================
# Env（重要）
# =========================
.env
.env.local
.env.*
!.env.example   # ← 允許範例檔上傳

# =========================
# IDE
# =========================
.vscode/
.idea/

# =========================
# Logs
# =========================
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# =========================
# Coverage / Testing
# =========================
coverage/
htmlcov/

# =========================
# Misc
# =========================
*.tmp
*.bak
*.swp

# =========================
# Mac / Windows hidden
# =========================
*.DS_Store?
._*